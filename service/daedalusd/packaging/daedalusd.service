# daedalusd: one Daedalus host, served on a unix socket.
# The socket is opened by daedalusd.socket and passed in, so the daemon starts on first use.

[Unit]
Description=Daedalus daemon
Documentation=https://github.com/Prometheus-Dynamics/Daedalus
Requires=daedalusd.socket
After=daedalusd.socket
# Never turned off for restarting too often. An operator stops it with `systemctl stop`.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/daedalusd --config /etc/daedalusd/daedalusd.toml
User=daedalusd
Group=daedalusd

# SIGTERM stops the listeners, cancels the runs and releases the plugins. The daemon gives
# itself 10 s for each, so the manager waits a little longer before it kills.
KillSignal=SIGTERM
TimeoutStopSec=30

# The failure rule: never give up, and wait at most 8 s between attempts.
Restart=on-failure
RestartSec=1
RestartSteps=4
RestartMaxDelaySec=8

# /run/daedalusd, owned by the service user. The socket unit made it first; this keeps it.
RuntimeDirectory=daedalusd
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes

# Hardening. Plugins are read from /usr/lib/daedalusd/plugins, which stays read-only.
ProtectSystem=strict
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
