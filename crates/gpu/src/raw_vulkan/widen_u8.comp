#version 450
// Test fixture for raw_vulkan_tests: reads 8-bit samples from a storage buffer (needs
// storageBuffer8BitAccess), as Styx's gpuisp does. Rebuild with:
//   glslangValidator -V --target-env vulkan1.1 widen_u8.comp -o widen_u8.spv
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer Src { uint8_t src[]; };
layout(std430, set = 0, binding = 1) buffer Dst { uint dst[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < dst.length()) {
        dst[i] = uint(src[i]) * 3u;
    }
}
