# Found by find_package(daedalus CONFIG). Defines these targets, at the install prefix this file was
# installed under:
#   daedalus::daedalus   the worker SDK's headers, and the libraries they need
#   daedalus::rust       the Rust library behind the worker C API
#   daedalus::host       daedalus.h and daedalus_host.hpp, over the host C API library
#   daedalus::client     daedalus_client.h and daedalus_client.hpp, over the client C API library
#
# The headers need C++17: each target carries it, so a consumer at an older standard (MSVC's default
# is C++14) is raised to it.
#
# A program built with MSVC must use the release DLL C runtime, as the Rust libraries do. CMake's
# default there is that runtime, so a consumer keeps the default or sets
# CMAKE_MSVC_RUNTIME_LIBRARY to MultiThreadedDLL. The host and client libraries are shared: a
# consumer finds them at run time beside the program, or through its library path.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

if(NOT TARGET daedalus::rust)
  add_library(daedalus::rust STATIC IMPORTED)
  set_target_properties(daedalus::rust PROPERTIES
    IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@DAEDALUS_RUST_INSTALL_PATH@")
endif()

if(NOT TARGET daedalus::daedalus)
  add_library(daedalus::daedalus INTERFACE IMPORTED)
  set_target_properties(daedalus::daedalus PROPERTIES
    INTERFACE_COMPILE_FEATURES cxx_std_17
    INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@DAEDALUS_INCLUDE_INSTALL_DIR@"
    INTERFACE_LINK_LIBRARIES "daedalus::rust;@DAEDALUS_PLATFORM_LINK_LIBS@")
endif()

if(NOT TARGET daedalus::host_library)
  add_library(daedalus::host_library SHARED IMPORTED)
  set_target_properties(daedalus::host_library PROPERTIES
    IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@DAEDALUS_HOST_INSTALL_PATH@")
  if(WIN32)
    set_target_properties(daedalus::host_library PROPERTIES
      IMPORTED_IMPLIB "${PACKAGE_PREFIX_DIR}/@DAEDALUS_HOST_INSTALL_PATH@.lib")
  endif()
endif()

if(NOT TARGET daedalus::client_library)
  add_library(daedalus::client_library SHARED IMPORTED)
  set_target_properties(daedalus::client_library PROPERTIES
    IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@DAEDALUS_CLIENT_INSTALL_PATH@")
  if(WIN32)
    set_target_properties(daedalus::client_library PROPERTIES
      IMPORTED_IMPLIB "${PACKAGE_PREFIX_DIR}/@DAEDALUS_CLIENT_INSTALL_PATH@.lib")
  endif()
endif()

if(NOT TARGET daedalus::host)
  add_library(daedalus::host INTERFACE IMPORTED)
  set_target_properties(daedalus::host PROPERTIES
    INTERFACE_COMPILE_FEATURES cxx_std_17
    INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@DAEDALUS_INCLUDE_INSTALL_DIR@"
    INTERFACE_LINK_LIBRARIES "daedalus::host_library;@DAEDALUS_PLATFORM_LINK_LIBS@")
endif()

if(NOT TARGET daedalus::client)
  add_library(daedalus::client INTERFACE IMPORTED)
  set_target_properties(daedalus::client PROPERTIES
    INTERFACE_COMPILE_FEATURES cxx_std_17
    INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@DAEDALUS_INCLUDE_INSTALL_DIR@"
    INTERFACE_LINK_LIBRARIES "daedalus::client_library;@DAEDALUS_PLATFORM_LINK_LIBS@")
endif()

check_required_components(daedalus)
